{
    "name": "nest-modules",
    "version": "0.0.0",
    "private": true,
    "description": "",
    "author": "",
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.3.13",
    "workspaces": ["lib", "e2e"],
    "scripts": {
        "build": "turbo run build",
        "build:lib": "turbo run build --filter=nestjs-rate-limiter",
        "build:e2e": "turbo run build --filter=e2e",
        "test:unit": "turbo run test:unit",
        "test:integration": "./scriipts/start-containers.sh && ./scripts/stop-containers.sh",
        "format:check": "biome format",
        "format:fix": "biome format --write",
        "lint:check": "biome lint",
        "lint:fix": "biome lint --write",
        "knip": "knip",
        "sync-meta": "./scripts/sync-meta.sh"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "knip": "^6.23.0",
        "turbo": "^2.10.0"
    }
}

{
    "extends": ["config:base"],
    "semanticCommits": true,
    "timezone": "Europe/Moscow",
    "schedule": ["before 8am on monday"],
    "packageRules": [
        {
            "matchPackagePatterns": ["*"],
            "enabled": false
        },
        {
            "matchPackagePatterns": ["^@types/", "^@commitlint/"],
            "matchPackageNames": ["@biomejs/biome", "husky", "knip", "turbo"],
            "enabled": true,
            "matchDepTypes": ["devDependencies"],
            "automerge": true
        },
        {
            "matchPackagePatterns": ["^@types/"],
            "groupName": "TypeScript types (@types)"
        },
        {
            "matchPackageNames": ["@commitlint/cli", "@commitlint/config-angular", "husky"],
            "groupName": "Commits control and Git-hooks"
        },
        {
            "matchPackageNames": ["@biomejs/biome", "knip", "turbo"],
            "groupName": "Monorepo and code style"
        }
    ]
}

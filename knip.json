{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignore": ["./e2e/**/*", "./lib/tests/**/*.ts"],
    "ignoreDependencies": ["release-it"],
    "ignoreBinaries": ["release-it"],
    "rules": {
        "files": "error",
        "types": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "unlisted": "off"
    }
}

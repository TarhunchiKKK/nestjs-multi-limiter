{
    "name": "nestjs-multi-limiter",
    "version": "2.1.0",
    "description": "Rate Limiter module for NestJS framework",
    "keywords": ["nestjs", "rate-limit", "throttle", "security", "bruteforce", "express", "fastify", "ws", "gql", "rpc", "authorization"],
    "license": "MIT",
    "private": false,
    "author": {
        "name": "Konstantin Barilo",
        "email": "kostabarilo12@gmail.com",
        "url": "https://github.com/TarhunchiKKK"
    },
    "homepage": "https://tarhunchikkk.github.io/nestjs-multi-limiter/",
    "repository": {
        "type": "git",
        "url": "https://github.com/TarhunchiKKK/nestjs-multi-limiter.git"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": ["dist", "lua"],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test:unit": "bun test tests/unit --preload ../scripts/test/preload.ts",
        "test:integration": "bun test tests/integration --preload ../scripts/test/preload.ts"
    },
    "devDependencies": {
        "@nestjs/common": "^11.1.27",
        "@nestjs/core": "^11.1.27",
        "@nestjs/testing": "^11.1.27",
        "@types/bun": "latest",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "express": "^5.2.1",
        "ioredis": "^5.11.1",
        "redis": "^6.1.0",
        "reflect-metadata": "^0.2.2",
        "typescript": "^5"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "reflect-metadata": "^0.2.2"
    }
}
